{
    "name": "next/next-theme-json-setup",
    "description": "Override and apply a theme's theme.json from the WordPress admin without modifying theme files.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/AtsushiA/NExT-theme-json-setup",
    "authors": [
        {
            "name": "NExT",
            "homepage": "https://next-season.net"
        }
    ],
    "support": {
        "issues": "https://github.com/AtsushiA/NExT-theme-json-setup/issues",
        "source": "https://github.com/AtsushiA/NExT-theme-json-setup"
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "yoast/wp-test-utils": "^1.2"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
